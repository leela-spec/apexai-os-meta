            "type": "string",
            "minLength": 1
          }
        },
        "aggregation": {
          "const": "prohibited"
        },
        "reading_priority": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "owner",
        "tiers",
        "dimensions",
        "aggregation",
        "reading_priority"
