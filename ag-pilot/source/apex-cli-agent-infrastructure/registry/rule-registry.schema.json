              "comparison",
              "patch",
              "grounding",
              "context",
              "handoff",
              "alignment",
              "schema",
              "sync"
            ]
          },
          "representation": {
            "type": "string",
            "minLength": 1
          },
          "activation": {
            "type": "object",
            "properties": {
              "mechanism_status": {
                "const": "proposed_unapproved"
              },
              "trigger_evaluation": {
                "type": "string",
                "minLength": 1
              },
              "delivery_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "source_read_receipt": {
                "type": "string",
                "minLength": 1
              },
              "no_hook_fallback": {
                "type": "string",
                "minLength": 1
              },
              "delivery_plan": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "required_on_match",
                  "conditional_details",
                  "selection_rule"
                ],
                "properties": {
                  "required_on_match": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "conditional_details": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "selection_rule": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "required": [
              "mechanism_status",
              "trigger_evaluation",
              "delivery_refs",
              "source_read_receipt",
              "no_hook_fallback",
              "delivery_plan"
            ],
            "additionalProperties": false
          },
          "verification": {
            "type": "object",
            "properties": {
              "observable_check": {
                "type": "string",
                "minLength": 1
              },
              "activation_observable": {
                "type": "string",
                "minLength": 1
              },
              "source_read_observable": {
                "type": "string",
                "minLength": 1
              },
              "adherence_observable": {
                "type": "string",
                "minLength": 1
              },
              "outcome_observable": {
                "type": "string",
                "minLength": 1
              },
              "independence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "observable_check",
              "activation_observable",
              "source_read_observable",
              "adherence_observable",
              "outcome_observable",
              "independence"
            ],
            "additionalProperties": false
          },
          "failure_handling": {
            "type": "string",
            "minLength": 1
          },
          "platform_conditions": {
            "type": "object",
            "properties": {
              "codex": {
                "type": "string",
                "minLength": 1
              },
              "claude_code": {
                "type": "string",
                "minLength": 1
              },
              "antigravity": {
                "type": "string",
                "minLength": 1
              },
              "universal": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "codex",
              "claude_code",
              "antigravity",
              "universal"
            ],
            "additionalProperties": false
          },
          "adoption": {
            "type": "object",
            "properties": {
              "meaning": {
                "type": "string",
                "minLength": 1
              },
              "activation_architecture": {
                "type": "string",
                "minLength": 1
              },
              "installed": {
                "type": "string",
                "minLength": 1
              },
              "approval_required": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "meaning",
              "activation_architecture",
              "installed",
              "approval_required"
            ],
            "additionalProperties": false
          },
          "maintenance": {
            "type": "object",
            "properties": {
              "owner_change": {
                "type": "string",
                "minLength": 1
              },
              "drift_check": {
                "type": "string",
                "minLength": 1
              },
              "revalidation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "owner_change",
              "drift_check",
              "revalidation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "source",
          "canonical_owner",
          "definition_role",
          "intended_behavior",
          "source_priority",
          "scope",
          "dependencies",
          "precedence",
          "lifecycle_profile",
          "representation",
          "activation",
          "verification",
          "failure_handling",
