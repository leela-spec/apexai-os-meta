        "required": [
          "id",
          "topic",
          "sources",
          "finding",
          "resolution",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(XML\\.[a-z_]+|(?:WP|FA|AD|EM|GS)-[0-9]+[a-z]?|(?:SCOPE|HOST)\\.[a-z-]+)$"
          },
          "kind": {
            "enum": [
              "xml_rule",
              "downstream_rule",
              "supplemental_rule"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "section": {
                "type": "string",
                "minLength": 1
              },
              "lines": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "evidence_class": {
                "const": "repository_observed"
              }
            },
            "required": [
              "repository",
              "revision",
              "path",
              "section",
              "lines",
              "sha256",
              "quote",
              "evidence_class"
            ],
            "additionalProperties": false
          },
          "canonical_owner": {
            "type": "object",
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "section": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "rule_id",
              "path",
              "section"
            ],
            "additionalProperties": false
          },
          "definition_role": {
            "enum": [
              "canonical_definition",
              "delegated_view",
              "reduced_contract"
            ]
          },
          "intended_behavior": {
            "type": "string",
            "minLength": 1
          },
          "source_priority": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "string",
                "minLength": 1
              },
              "raw": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tier": {
                "enum": [
                  "P0",
                  "P1",
                  "P2",
                  "P3",
                  null
                ]
              },
              "impact": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 100
              },
              "evidence": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 100
              },
              "risk": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 100
              },
              "interpretation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "origin",
              "raw",
              "tier",
              "impact",
              "evidence",
              "risk",
              "interpretation"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "origin": {
                      "const": "recorded"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "raw": {
                      "type": "string",
                      "pattern": "^\\[P[0-3] \\| I\\d+/E\\d+/R\\d+\\]$"
                    },
                    "tier": {
                      "enum": [
                        "P0",
                        "P1",
                        "P2",
                        "P3"
                      ]
                    },
                    "impact": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "evidence": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "risk": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    }
                  }
                },
                "else": {
                  "properties": {
                    "raw": {
                      "type": "null"
                    },
                    "tier": {
                      "type": "null"
                    },
                    "impact": {
                      "type": "null"
                    },
                    "evidence": {
                      "type": "null"
                    },
                    "risk": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          },
          "scope": {
            "type": "object",
            "properties": {
              "trigger": {
                "type": "string",
                "minLength": 1
              },
              "source_trigger": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "exclusions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "class": {
                "enum": [
                  "invariant",
                  "authoring",
                  "comparison",
                  "patch",
                  "grounding",
                  "context",
                  "handoff",
                  "alignment",
                  "schema",
                  "sync"
                ]
              }
            },
            "required": [
              "trigger",
              "source_trigger",
              "exclusions",
              "class"
            ],
            "additionalProperties": false
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
