{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apexai-os-meta/schemas/presentation-handoff.schema.json",
  "title": "PrecapWeek Presentation Handoff (Single Downstream Contract)",
  "description": "Sole machine-readable handoff emitted by PrecapWeek for PrecapNextDay. Owned centrally here so SPEC-PRECAP-WEEK-ITERATIONS.okf.md, PrecapWeek, and PrecapNextDay share identical field names and enums.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "packet_id",
    "produced_at",
    "week",
    "date_range",
    "timezone",
    "clock_owner",
    "dispersal_owner",
    "cockpit_html_ref",
    "brief_okf_ref",
    "data_json_ref",
    "result_state",
    "operator_g1_status",
    "source_status",
    "weekly_intent",
    "six_portfolio_areas",
    "reconciled_calendar_events",
    "capacity_deformations_and_omissions",
    "next_day_seed",
    "next_consumer"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "PRECAP-WEEK-HANDOFF-v2.1"
    },
    "artifact_type": {
      "type": "string",
      "const": "Weekly_Command_Brief"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "produced_at": {
      "type": "string",
      "minLength": 1
    },
    "week": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "date_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "end": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "timezone": {
      "type": "string",
      "const": "Europe/Berlin"
    },
    "clock_owner": {
      "type": "string",
      "const": "apex-meta/tools/project-improvement-orchestration-weekly/02-weekly-dispersal/week-blueprint.json"
    },
    "dispersal_owner": {
      "type": "string",
      "const": "apex-meta/tools/project-improvement-orchestration-weekly/02-weekly-dispersal/week-allocation.json"
    },
    "cockpit_html_ref": { "type": "string", "minLength": 1 },
    "brief_okf_ref": { "type": "string", "minLength": 1 },
    "data_json_ref": { "type": "string", "minLength": 1 },
    "result_state": {
      "type": "string",
      "enum": ["READY", "READY_WITH_REVIEW", "PARTIAL", "BLOCKED"]
    },
    "operator_g1_status": {
      "type": "string",
      "enum": ["PROPOSED_FOR_G1", "APPROVED", "EDITED", "REJECTED"]
    },
    "source_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openproject", "google_calendar"],
      "properties": {
        "openproject": {
          "type": "string",
          "enum": ["ONLINE", "OFFLINE_FALLBACK"]
        },
        "google_calendar": {
          "type": "string",
          "enum": ["ONLINE", "OFFLINE_FALLBACK"]
        }
      }
    },
    "weekly_intent": {
      "type": "string",
      "minLength": 1
    },
    "six_portfolio_areas": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["portfolio_id", "label", "priority_rank", "priority_goals", "selected_work_refs"],
        "properties": {
          "portfolio_id": {
            "type": "string",
            "enum": ["leela", "ipos", "master_of_arts", "apex_ai", "mindful_bar", "residual"]
          },
          "label": {
            "type": "string",
            "enum": ["Leela", "IPOS", "Master of Arts", "Apex AI", "Mindful Bar", "Residual"]
          },
          "priority_rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "priority_goals": {
            "type": "array",
            "items": { "type": "string" }
          },
          "selected_work_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "reconciled_calendar_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "title", "start", "end", "policy", "capacity_delta_min"],
        "properties": {
          "date": { "type": "string" },
          "title": { "type": "string" },
          "start": { "type": "string" },
          "end": { "type": "string" },
          "policy": { "type": "string", "enum": ["protected", "ignored_ongoing", "buffer"] },
          "capacity_delta_min": { "type": "integer" }
        }
      }
    },
    "capacity_deformations_and_omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day", "flow", "shape", "reason"],
        "properties": {
          "day": { "type": "string" },
          "flow": { "type": "string" },
          "shape": { "type": "string", "enum": ["full", "compressed", "minimal", "omitted"] },
          "reason": { "type": "string" }
        }
      }
    },
    "next_day_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_date", "intended_emphasis"],
      "properties": {
        "target_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "intended_emphasis": { "type": "string", "minLength": 1 }
      }
    },
    "next_consumer": {
      "type": "string",
      "const": "PrecapNextDay"
    }
  }
}
