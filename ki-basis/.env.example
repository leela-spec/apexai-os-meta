# ki-basis Environment Configuration Template
# -----------------------------------------------------------------------------
# DUAL-INSTANCE ARCHITECTURE (Private vs. Community)
# 
# Usage for Private Stack:
#   docker compose -p ki-basis-private --env-file .env.private up -d
# 
# Usage for Community Stack:
#   docker compose -p ki-basis-community --env-file .env.community up -d
# 
# NEVER COMMIT LIVE SECRETS TO VERSION CONTROL (.env.private and .env.community are gitignored).
# -----------------------------------------------------------------------------

# =============================================================================
# 1. Project & Network Namespaces
# =============================================================================
# Set to 'ki-basis-private' for Private or 'ki-basis-community' for Community.
COMPOSE_PROJECT_NAME=ki-basis

# Isolated Docker bridge network name ('ki-basis-private-net' vs 'ki-basis-community-net').
KI_NETWORK_NAME=ki-basis-net

# =============================================================================
# 2. Host Port Allocations (Strict Loopback 127.0.0.1 Binding)
#    - Private Port Band:   8080-8089, 8642, 9119
#    - Community Port Band: 9080-9089, 9642, 9219
# =============================================================================
FIREFLY_HOST_PORT=8086
PAPERLESS_HOST_PORT=8010
OPENPROJECT_HOST_PORT=8082
NGINX_HOST_PORT=8084
HERMES_GATEWAY_HOST_PORT=8642
HERMES_DASHBOARD_HOST_PORT=9119

# =============================================================================
# 3. Headless & Runtime Stability Controls
# =============================================================================
# OpenProject: Single Puma worker eliminates Puma cluster multi-process overhead (~450MB vs ~900MB+).
OPENPROJECT_WEB_WORKERS=1
OPENPROJECT_BACKGROUND_WORKERS=1
# Wait time in seconds for PostgreSQL readiness before running database migrations.
PG_STARTUP_WAIT_TIME=60

# Paperless: Granian web workers & Celery task concurrency limits to prevent CPU thrashing.
PAPERLESS_WORKERS=1
PAPERLESS_TASK_WORKERS=1
PAPERLESS_THREADS_PER_WORKER=1

# =============================================================================
# 4. PostgreSQL Database Configuration
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# =============================================================================
# 5. Firefly III Financial Accounting
# =============================================================================
FIREFLY_DB_USER=firefly_app
FIREFLY_DB_PASSWORD=
FIREFLY_DB_NAME=firefly
# APP_KEY must be exactly 32 characters or base64:32bytes.
FIREFLY_APP_KEY=

# =============================================================================
# 6. Paperless-ngx Document Archival
# =============================================================================
PAPERLESS_DB_USER=paperless_app
PAPERLESS_DB_PASSWORD=
PAPERLESS_DB_NAME=paperless
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=

# =============================================================================
# 7. OpenProject Enterprise Project Governance
# =============================================================================
OPENPROJECT_DB_USER=openproject_app
OPENPROJECT_DB_PASSWORD=
OPENPROJECT_DB_NAME=openproject
# OPENPROJECT_SECRET_KEY_BASE must be a 64+ char random hex string.
OPENPROJECT_SECRET_KEY_BASE=

# =============================================================================
# 8. Hermes AI Operating Surface & Telegram Gateway
# =============================================================================
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Local machine-to-machine key for CLI agents -> Hermes API server.
HERMES_API_SERVER_KEY=
# Telegram Bot Token (Must be unique per stack to prevent Telegram API 409 conflicts).
TELEGRAM_BOT_TOKEN=

# =============================================================================
# 9. Verification & Automation API Tokens
# =============================================================================
FIREFLY_API_TOKEN=
PAPERLESS_API_TOKEN=
OPENPROJECT_API_KEY=
