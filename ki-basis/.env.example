# ==============================================================================
# ki-basis Docker Stack — Environment Configuration Example
# ==============================================================================
# COPY THIS FILE TO .env BEFORE RUNNING: cp .env.example .env
# NEVER COMMIT REAL SECRETS TO VERSION CONTROL.

# Stack project & network name
COMPOSE_PROJECT_NAME=ki-basis
KI_NETWORK_NAME=ki-basis-net

# Host Port Mappings (127.0.0.1 bindings to avoid collisions)
NGINX_HOST_PORT=8084
FIREFLY_HOST_PORT=8086
PAPERLESS_HOST_PORT=8010
OPENPROJECT_HOST_PORT=8082
HERMES_DASHBOARD_HOST_PORT=8642
HERMES_GATEWAY_HOST_PORT=9119

# PostgreSQL Credentials (Internal only - no host exposure)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_placeholder_password
POSTGRES_DB=postgres

# Application Database Credentials & Secrets
FIREFLY_DB_USER=firefly_app
FIREFLY_DB_PASSWORD=firefly_secure_placeholder_password
FIREFLY_DB_NAME=firefly
FIREFLY_APP_KEY=SomeRandomStringOf32CharsExact!!

PAPERLESS_DB_USER=paperless_app
PAPERLESS_DB_PASSWORD=paperless_secure_placeholder_password
PAPERLESS_DB_NAME=paperless
PAPERLESS_SECRET_KEY=paperless_placeholder_secret_key_change_me
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=AdminSecurePassword123!

OPENPROJECT_DB_USER=openproject_app
OPENPROJECT_DB_PASSWORD=openproject_secure_placeholder_password
OPENPROJECT_DB_NAME=openproject
OPENPROJECT_SECRET_KEY_BASE=openproject_placeholder_secret_key_base_change_me

# Hermes AI Operating Surface
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=hermes_secure_placeholder_password
