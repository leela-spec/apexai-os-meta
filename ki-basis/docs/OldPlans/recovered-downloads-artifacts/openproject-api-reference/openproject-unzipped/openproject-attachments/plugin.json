{
  "active": true,
  "hubId": "openproject-attachments",
  "name": "OpenProject Attachments",
  "schema": "skill-1.0.0",
  "version": "1.0.0",
  "description": "OpenProject Attachments API",
  "author": "ki-basis",
  "license": "MIT",
  "imported": true,
  "entrypoint": {
    "file": "handler.js",
    "params": {
      "operation": {
        "type": "string",
        "description": "One of: create|delete|get|list_by_meeting|add_to_meeting|list_by_post|add_to_post|list_by_wiki_page|add_to_wiki_page|list_work_package|create_work_package"
      },
      "id": {
        "type": "integer",
        "description": "Attachment id — integer (numeric string ok) (operations: delete, get, list_by_meeting, add_to_meeting, list_by_post, add_to_post, list_by_wiki_page, add_to_wiki_page, list_work_package, create_work_package)"
      },
      "confirmed": {
        "type": "string",
        "description": "Optional. Two-Phase write confirm: set confirmed=true (or ja/yes/1) to execute POST/PATCH/PUT/DELETE. Without it, mutating calls return a confirmation ask."
      }
    }
  },
  "setup_args": {
    "openproject_base_url": {
      "type": "string",
      "required": true,
      "input": {
        "type": "text",
        "default": "http://web:8080",
        "hint": "Interne OpenProject-API-Basis (im Docker-Netz, Port 8080)"
      }
    },
    "openproject_token": {
      "type": "string",
      "required": true,
      "input": {
        "type": "password",
        "hint": "OpenProject-API-Key (Basic apikey:<key>; aus Benutzerprofil)"
      }
    }
  }
}
