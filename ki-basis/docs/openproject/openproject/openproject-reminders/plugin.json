{
  "active": true,
  "hubId": "openproject-reminders",
  "name": "OpenProject Reminders",
  "schema": "skill-1.0.0",
  "version": "1.0.0",
  "description": "OpenProject Reminders API",
  "author": "ki-basis",
  "license": "MIT",
  "imported": true,
  "entrypoint": {
    "file": "handler.js",
    "params": {
      "operation": {
        "type": "string",
        "description": "One of: list|delete|update"
      },
      "id": {
        "type": "integer",
        "description": "Reminder ID — integer (numeric string ok) (operations: delete, update)"
      },
      "remindAt": {
        "type": "string",
        "description": "The date and time when the reminder is due (operations: update)"
      },
      "note": {
        "type": "string",
        "description": "The note of the reminder (optional) (operations: update)"
      },
      "confirmed": {
        "type": "string",
        "description": "Optional. Two-Phase write confirm: set confirmed=true (or ja/yes/1) to execute POST/PATCH/PUT/DELETE. Without it, mutating calls return a confirmation ask."
      }
    }
  },
  "setup_args": {
    "openproject_base_url": {
      "type": "string",
      "required": true,
      "input": {
        "type": "text",
        "default": "http://web:8080",
        "hint": "Interne OpenProject-API-Basis (im Docker-Netz, Port 8080)"
      }
    },
    "openproject_token": {
      "type": "string",
      "required": true,
      "input": {
        "type": "password",
        "hint": "OpenProject-API-Key (Basic apikey:<key>; aus Benutzerprofil)"
      }
    }
  }
}
