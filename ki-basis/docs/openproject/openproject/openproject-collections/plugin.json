{
  "active": true,
  "hubId": "openproject-collections",
  "name": "OpenProject Collections",
  "schema": "skill-1.0.0",
  "version": "1.0.0",
  "description": "OpenProject Collections API",
  "author": "ki-basis",
  "license": "MIT",
  "imported": true,
  "entrypoint": {
    "file": "handler.js",
    "params": {
      "operation": {
        "type": "string",
        "description": "One of: get_aggregated_result"
      },
      "groupBy": {
        "type": "string",
        "description": "The column to group by.\nNote: Aggregation is as of now only supported by the work package collection.\nYou can pass any column name as returned by the [queries](https://www.openproject.org/docs/api/endpoints/queries/) endpoint. (operations: get_aggregated_result)"
      },
      "showSums": {
        "type": "boolean",
        "description": "showSums (operations: get_aggregated_result)"
      },
      "confirmed": {
        "type": "string",
        "description": "Optional. Two-Phase write confirm: set confirmed=true (or ja/yes/1) to execute POST/PATCH/PUT/DELETE. Without it, mutating calls return a confirmation ask."
      }
    }
  },
  "setup_args": {
    "openproject_base_url": {
      "type": "string",
      "required": true,
      "input": {
        "type": "text",
        "default": "http://web:8080",
        "hint": "Interne OpenProject-API-Basis (im Docker-Netz, Port 8080)"
      }
    },
    "openproject_token": {
      "type": "string",
      "required": true,
      "input": {
        "type": "password",
        "hint": "OpenProject-API-Key (Basic apikey:<key>; aus Benutzerprofil)"
      }
    }
  }
}
